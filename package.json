{
  "name": "persona-advisor-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "build:aab:smarter7yo": "eas build --platform android --profile production-smarter7yo",
    "build:aab:minds": "eas build --platform android --profile production-minds",
    "build:aab:ocr": "eas build --platform android --profile production-ocr",
    "build:apk:smarter7yo": "eas build --platform android --profile apk-smarter7yo",
    "build:apk:minds": "eas build --platform android --profile apk-minds",
    "build:apk:ocr": "eas build --platform android --profile apk-ocr"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.37",
    "expo-av": "~15.0.2",
    "expo-constants": "~17.0.7",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-speech": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^0.468.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
