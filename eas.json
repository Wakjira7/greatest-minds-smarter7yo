{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "apk-smarter7yo": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "smarter7yo",
        "EXPO_PUBLIC_RELEASE_MODE": "production"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "apk-minds": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "minds",
        "EXPO_PUBLIC_RELEASE_MODE": "production"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "apk-ocr": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "ocr",
        "EXPO_PUBLIC_RELEASE_MODE": "production"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-smarter7yo": {
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "smarter7yo",
        "EXPO_PUBLIC_RELEASE_MODE": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-minds": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "minds",
        "EXPO_PUBLIC_RELEASE_MODE": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-ocr": {
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "ocr",
        "EXPO_PUBLIC_RELEASE_MODE": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "smarter7yo",
        "EXPO_PUBLIC_RELEASE_MODE": "production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
