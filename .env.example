# Mobile App Public Environment Variables (Safe for Client Bundle)
# Once you deploy the Supabase Edge Function, paste your project URL and Anon Key below.
# When left blank, the app runs in Instant In-Character Preview Mode (Mock Fallback).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Server-Side Secrets (Configure ONLY in Supabase Edge Function Secrets, NEVER in client)
# Run: supabase secrets set GEMINI_API_KEY="your-google-ai-studio-key" GEMINI_MODEL="gemini-4-argon"
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSyYourKeyHere
# GEMINI_MODEL=gemini-4-argon
